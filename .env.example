# --- AI provider (required for --ai mode) -------------------------------
# Any OpenAI-compatible endpoint works. Run:  python setup_provider.py
# It asks for the base URL + key, lists that provider's models and writes
# AI_BASE_URL / AI_API_KEY / AI_MODEL here for you.
#
# Examples:
#   OpenAI        https://api.openai.com/v1
#   OpenRouter    https://openrouter.ai/api/v1
#   Groq          https://api.groq.com/openai/v1
#   Together      https://api.together.xyz/v1
#   DeepSeek      https://api.deepseek.com/v1
#   Mistral       https://api.mistral.ai/v1
#   xAI           https://api.x.ai/v1
#   Cerebras      https://api.cerebras.ai/v1
#   NVIDIA NIM    https://integrate.api.nvidia.com/v1
#   Ollama        http://localhost:11434/v1
#   LM Studio     http://localhost:1234/v1
#   OpenCode Zen  https://opencode.ai/zen/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-key-here
AI_MODEL=gpt-4o-mini
# Optional. Empty = the field is not sent at all (most providers reject it).
# Options on some providers: Default, Low, Medium, High, Xhigh, Max
AI_REASONING_EFFORT=
AI_MAX_TOKENS=4096
# Ask the provider for strict JSON output. 1 = on. Off by default.
AI_JSON_MODE=0

# --- LIVE trading (optional, REAL money). Leave blank for paper mode. ---
LIVE_TRADING=
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=1
